# Local Postgres (via docker-compose)
# In production (Neon): use the POOLED connection string here at runtime.
# Use Neon's DIRECT (unpooled) connection string only for one-off local runs of
# `prisma migrate deploy` / `prisma db seed` against production - never as the
# Vercel runtime env var.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/house_marketing_cms

# Local SMTP sandbox (Mailpit, via docker-compose) - no auth required
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=updates@house-marketing-cms.local
# Only needed for a real SMTP provider (e.g. Brevo) - leave unset for Mailpit
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# In production, set RESEND_API_KEY instead of the SMTP_* vars above - Resend's
# HTTP API is used automatically when this is set (lib/mailer.ts). Raw SMTP is
# unreliable from serverless platforms like Vercel (outbound SMTP ports are
# often blocked/filtered), so SMTP here is for local Mailpit only.
# RESEND_API_KEY=<your Resend API key>
# SMTP_FROM must still be set in production too - e.g. onboarding@resend.dev

# NextAuth
# In production this MUST be your real https:// deployment URL, kept in sync
# with NEXTAUTH_SECRET - both drive secure-cookie behavior and are also used
# to build unsubscribe/news links in campaign emails (lib/campaigns/sendCampaign.ts).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Seeded admin user (npx prisma db seed)
# For production, only ever set these transiently in your local shell when
# running `prisma db seed` once against the production DATABASE_URL - never
# add them as permanent Vercel environment variables.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
