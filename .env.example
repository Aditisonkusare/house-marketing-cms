# Local Postgres (via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/house_marketing_cms

# Local SMTP sandbox (Mailpit, via docker-compose) - no auth required
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=updates@house-marketing-cms.local
# Only needed for a real provider (e.g. Resend, Brevo) - leave unset for Mailpit
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Seeded admin user (npx prisma db seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
